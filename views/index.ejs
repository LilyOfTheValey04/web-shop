
<!DOCTYPE html>
<html>	
<head>
   
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" type="text/css" href="style.css"/>
    <link rel="icon" href="images/icon.png" type="image/png">	
    <title>Celestial jewelry</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
</head>
<body>

    <div class="header-container">
  
        <!-- Лого (линк към началната страница) -->
        <a href="index.html" class="logo-link">
          <img src="images/logo3.png" alt="logo" class="logo">
        </a>
      
        <!-- Навигационно меню -->
        <div class="topnav">
          <a href="index.html">Home</a>
          <a class="active" href="#">About us</a>
          <a href="#products">Products</a>
          <a href="#contact">Contacts</a>

          <div class="profile">
            <a href="logIn.html">
              <img src="images/user.png" alt ="User Icon" class="user-icon">
            </a>
          </div>
          
          <!-- Иконка на количката -->
          <div class="card-container">
            <a href="buyForm.html">
              <img src="images/bag2.png" alt="Shopping Cart" class="cart-icon">
              <span id="cart-count">0</span>
            </a>
          </div>
        </div>
      </div>

<!-- Home Section -->

<section class="hero-section">
    <div class="hero-content">
      <div class="hero-text">
        <h2 id="hero-heading"></h2>
        <p id="hero-paragraph"></p>
      </div>
      <div class="hero-image">
        <img src="images/home1.jpg" alt="newProduct">
      </div>
    </div>
  </section>
  
 
    <!-- Product Section -->
    <main>
        <section class="products">
            <h2>Recommended For You</h2>
            <div class="product-container">
              <% products.forEach(product => { %>
          <article class="product">
            <img src="<%= product.image %>" alt="<%= product.name %>">
            <h3><%= product.name %></h3>
            <p><%= product.shortDescription %></p>
            <p><strong>Price:</strong> <%= product.price %></p>
            <a href="/api/products/<%= product._id %>" class="product-link">See more</a>

            <!-- <a href="product4.html" class="product-link">See more</a> ! -->
          </article>
        <% }) %>   
				
            </div>
        </section>
    </main>
		  
<!-- Footer Section -->
<footer>
  <div class="footer-logo">
    <img src="images/logo-fotter.png" alt="logo">
  </div>
  <div class="footer-contacts">
      <h3>Contact Details</h3>
      <div class="phoneNumber">
          <p>Call:</p>
          <p>+359 89 000 0000</p>
      </div>
      <div class="email">
          <p>Email:</p>
          <p>Celestial_jewelry@gmail.com</p>
      </div>
  </div>

  <div class="footer-social">
      <h3>Follow us on social media</h3>
      <div class="footer-img">
          <a href="https://facebook.com" target="_blank">
              <img src="images/facebook.png" alt="Facebook">
          </a>
          <a href="https://instagram.com" target="_blank">
              <img src="images/instagram (1).png" alt="Instagram">
          </a>
          <a href="https://pinterest.com" target="_blank">
              <img src="images/pinterest.png" alt="Pinterest">
          </a>
      </div>
  </div>

 <!-- <div class="footer-policy">
      <a href="privacy.html">Privacy Policy</a> |
      <a href="terms.html">Terms of Service</a>
  </div> !-->

  <div class="footer-copyright">
      <p>© 2025 Celestial Jewelry. All rights reserved.</p>
  </div>
</footer>


        <script src="script.js" ></script>

    </body>
</html>